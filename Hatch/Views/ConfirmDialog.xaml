<Window x:Class="Hatch.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hatch"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E2E" CornerRadius="8" BorderBrush="#3F3F46" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="MessageText"
                       AutomationProperties.AutomationId="ConfirmMessageText"
                       FontSize="13" Foreground="#E0E0E0"
                       TextWrapping="Wrap" Margin="0,0,0,20"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Click="Ok_Click"
                        AutomationProperties.AutomationId="ConfirmOkButton"
                        MinWidth="90" Height="30" Padding="10,0" Margin="0,0,8,0"
                        Background="#0078D4" Foreground="White" BorderBrush="#0078D4"
                        Cursor="Hand" FontSize="13"/>
                <Button x:Name="CancelButton" Click="Cancel_Click" IsCancel="True" IsDefault="True"
                        AutomationProperties.AutomationId="ConfirmCancelButton"
                        MinWidth="90" Height="30" Padding="10,0"
                        Background="#3F3F46" Foreground="#E0E0E0" BorderBrush="#3F3F46"
                        Cursor="Hand" FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
