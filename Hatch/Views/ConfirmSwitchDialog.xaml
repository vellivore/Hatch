<Window x:Class="Hatch.Views.ConfirmSwitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未保存の変更があります"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E2E" CornerRadius="8" BorderBrush="#3F3F46" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="未保存の変更があります"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#E0E0E0" Margin="0,0,0,12"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <TextBlock Grid.Row="1" x:Name="MessageText"
                       FontSize="13" Foreground="#D0D0D4"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="適用して切替" Click="ApplyAndSwitch_Click" AutomationProperties.AutomationId="SwitchApplyButton"
                        MinWidth="110" Height="30" Padding="10,0" Margin="0,0,8,0"
                        Background="#0078D4" Foreground="White" BorderBrush="#0078D4"
                        Cursor="Hand" FontSize="13" IsDefault="True"/>
                <Button Content="破棄して切替" Click="DiscardAndSwitch_Click" AutomationProperties.AutomationId="SwitchDiscardButton"
                        MinWidth="110" Height="30" Padding="10,0" Margin="0,0,8,0"
                        Background="#3F3F46" Foreground="#E0E0E0" BorderBrush="#3F3F46"
                        Cursor="Hand" FontSize="13"/>
                <Button Content="キャンセル" Click="Cancel_Click" AutomationProperties.AutomationId="SwitchCancelButton"
                        MinWidth="90" Height="30" Padding="10,0"
                        Background="#3F3F46" Foreground="#E0E0E0" BorderBrush="#3F3F46"
                        Cursor="Hand" FontSize="13" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
